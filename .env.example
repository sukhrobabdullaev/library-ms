# Copy this file to .env and fill in your values.

DATABASE_URL="postgresql://postgres:postgres@localhost:5438/library_ms?schema=public"

# Auth secret — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"

# Resend API key (leave blank in dev; emails log to console instead)
RESEND_API_KEY=""

# Cron secret — shared between Vercel Cron and the /api/cron/reminders route
CRON_SECRET="change-me-in-production"
